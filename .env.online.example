# Dominio DNS que apuntará al VPS. No incluya https:// en APP_DOMAIN.
APP_DOMAIN=presupuesto.ejemplo.cl
APP_ORIGIN=https://presupuesto.ejemplo.cl

# Reemplazar por secretos aleatorios y diferentes.
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
SECRET_KEY=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
INITIAL_PASSWORD=CAMBIAR_POR_CLAVE_TEMPORAL

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
